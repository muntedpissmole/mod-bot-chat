[worldserver]

###################################################################################################
# MOD-BOT-CHAT
# Real WoW chat: overlapping short lines, real back-and-forth,
# tone matching, no canned loops. Engine owns channel/combat/Questie/Trade/
# gz/help. Local Ollama only writes the sentence when a real player spoke.
# Ambient volume follows mod-circadian-bots pop. Trade ads are
# mod-trade-chat. Pass-by /hi is mod-well-met.
###################################################################################################

BotChat.Enable = 1
BotChat.DebugEnabled = 0

# Distances
BotChat.SayDistance = 40.0
BotChat.YellDistance = 100.0
BotChat.RandomChatterRealPlayerDistance = 200.0
BotChat.EventChatterRealPlayerDistance = 40.0

# Replies
BotChat.PlayerReplyChance.Say = 90
BotChat.BotReplyChance.Say = 10
BotChat.PlayerReplyChance.Channel = 80
BotChat.BotReplyChance.Channel = 8
BotChat.PlayerReplyChance.Party = 90
BotChat.BotReplyChance.Party = 25
BotChat.PlayerReplyChance.Guild = 70
BotChat.BotReplyChance.Guild = 1
BotChat.MaxBotsToPick = 1
BotChat.EnableSocialConventions = 1
BotChat.SocialCueSeconds = 45
BotChat.DisableRepliesInCombat = 1
BotChat.EnableWhisperReplies = 1
BotChat.AlwaysReplyToPlayerQuestions = 1
BotChat.QuestionReplyChanceBonus = 25

BotChat.DisableForCustomChannels = 0
BotChat.DisableForSayYell = 0
BotChat.DisableForGuild = 0
BotChat.DisableForParty = 0

# Ambient (peak-hour rates; live chance/interval scale with random-bot
# online count vs AiPlayerbot.MaxRandomBots unless ScaleWithPopulation = 0)
BotChat.EnableRandomChatter = 1
BotChat.MinRandomInterval = 45
BotChat.MaxRandomInterval = 180
BotChat.RandomChatterBotCommentChance = 18
BotChat.EnableGuildRandomAmbientChatter = 1
BotChat.GuildRandomChatterChance = 12
BotChat.ScaleWithPopulation = 1
BotChat.EnableChannelThreads = 1
BotChat.ChannelThreadMaxLines = 48
BotChat.TopicIdleSeconds = 180
BotChat.ContinueTopicChance = 40
BotChat.PreferThreadRegulars = 1

# Events
BotChat.EnableEventChatter = 1
BotChat.EventChatterBotCommentChance = 25
BotChat.EventChatterBotSelfCommentChance = 5
BotChat.EventCooldownTime = 10
BotChat.EnableGuildEventChatter = 1
BotChat.GuildChatterBotCommentChance = 15

# Knowledge
BotChat.EnableGameKnowledge = 1
BotChat.GameKnowledgeMaxFacts = 4

# Local Ollama wording layer (K8 GPU). Ambient General stays canned.
# llama3.2:3b is too small — use 7B/8B. Engine still gates every reply.
BotChat.EnableLLM = 1
BotChat.Url = http://127.0.0.1:11434/api/generate
BotChat.Model = llama3.1:8b
BotChat.NumPredict = 64
BotChat.Temperature = 0.95
BotChat.LLMTimeout = 15
BotChat.MaxConcurrentQueries = 1

# Typing delay
BotChat.EnableTypingSimulation = 1
BotChat.TypingSimulationBaseDelay = 800
BotChat.TypingSimulationDelayPerChar = 60

# Prefixes and addon announces (Questie, playerbot commands, ...)
BotChat.BlacklistCommands = /s,/g,/p,/y,/w,/say,/guild,/party,/yell,/whisper,autogear,talents,reset botAI,summon,release,revive,leave,attack,follow,flee,stay,runaway,grind,do ,questie,Questie:,{rt1} Questie,{star} Questie,pfQuest
